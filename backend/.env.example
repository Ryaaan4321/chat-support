# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# JWT Secret Key
JWT_SECRET="your-secure-random-jwt-secret-key"
JWT_EXPIRES_IN="24h"

# Allowed Client Origins for CORS (comma-separated if multiple, e.g. frontend URL and local dev)
CLIENT_ORIGIN="http://localhost:3000,https://your-frontend.vercel.app"

# Server Port (Render injects PORT automatically; fallback to 4001 locally)
PORT=4001

# Cloudinary Credentials (Media attachments and avatars)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
